# Deployment environment: development|staging|production (default: development)
APP_ENV=development

# HTTP server tuning (all optional; Go duration syntax for timeouts)
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Postgres connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/campsite_booking?sslmode=disable

# Cookie session signing secret, >= 32 characters (required)
SESSION_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Logging: debug|info|warn|error (default: info); text|json (default: text in dev, json elsewhere)
LOG_LEVEL=info
LOG_FORMAT=text
